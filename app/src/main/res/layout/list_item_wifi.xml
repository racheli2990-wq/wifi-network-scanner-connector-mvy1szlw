<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rounded_card_bg"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:padding="16dp"
    android:layoutDirection="rtl">

    <TextView
        android:id="@+id/wifi_ssid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_toStartOf="@+id/wifi_signal_strength_icon"
        android:textColor="@color/textColorPrimary"
        android:textAppearance="?android:attr/textAppearanceMedium"
        android:textStyle="bold"
        android:text="שם רשת Wi-Fi" />

    <TextView
        android:id="@+id/wifi_security_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/wifi_ssid"
        android:layout_alignParentStart="true"
        android:layout_marginTop="4dp"
        android:textColor="@color/textColorSecondary"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:text="אבטחה: WPA2" />

    <TextView
        android:id="@+id/wifi_signal_strength_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/wifi_ssid"
        android:layout_toStartOf="@+id/wifi_signal_strength_icon"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:textColor="@color/textColorSecondary"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:text="עוצמה: 75%" />

    <ImageView
        android:id="@+id/wifi_signal_strength_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentEnd="true"
        android:layout_alignTop="@id/wifi_ssid"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_wifi_signal_4"
        android:contentDescription="עוצמת אות Wi-Fi" />

    <ImageView
        android:id="@+id/wifi_security_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_below="@id/wifi_security_type"
        android:layout_alignParentStart="true"
        android:layout_marginTop="4dp"
        android:src="@drawable/ic_wifi_lock"
        android:contentDescription="אבטחת רשת" />

</RelativeLayout>
